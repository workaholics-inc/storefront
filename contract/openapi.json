{
  "openapi": "3.1.0",
  "info": {
    "title": "Workaholics Platform API",
    "version": "1.0.0"
  },
  "security": [
    {
      "storefrontKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "storefrontKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Storefront-Key"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "version",
          "time"
        ],
        "example": {
          "status": "ok",
          "version": "0.1.0",
          "time": "2026-10-17T08:30:00.000Z"
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ],
        "example": {
          "error": {
            "code": "storefront_key_invalid",
            "message": "Missing or invalid storefront key"
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The platform is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "The platform failed to answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
