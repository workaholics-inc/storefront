{
  "openapi": "3.1.0",
  "info": {
    "title": "Workaholics Platform API",
    "version": "1.0.0"
  },
  "security": [
    {
      "storefrontKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "storefrontKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Storefront-Key"
      },
      "memberSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "version",
          "time"
        ],
        "example": {
          "status": "ok",
          "version": "0.1.0",
          "time": "2026-10-17T08:30:00.000Z"
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ],
        "example": {
          "error": {
            "code": "storefront_key_invalid",
            "message": "Missing or invalid storefront key"
          }
        }
      },
      "SignInResponse": {
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "member": {
            "$ref": "#/components/schemas/Member"
          },
          "joined": {
            "type": "boolean"
          }
        },
        "required": [
          "session",
          "member",
          "joined"
        ],
        "example": {
          "session": {
            "token": "mock-session-token-not-a-secret-00000000000",
            "expiresAt": "2026-11-19T10:00:00.000Z"
          },
          "member": {
            "handle": "sara",
            "displayName": "سارا رحیمی",
            "bio": "",
            "links": [],
            "invitedBy": null,
            "joinedAt": "2026-10-20T10:00:00.000Z"
          },
          "joined": true
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "token",
          "expiresAt"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "maxItems": 5
          },
          "invitedBy": {
            "$ref": "#/components/schemas/MemberRef"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "handle",
          "displayName",
          "bio",
          "links",
          "invitedBy",
          "joinedAt"
        ],
        "example": {
          "handle": "sara",
          "displayName": "سارا رحیمی",
          "bio": "برنامه‌نویس و سازندهٔ دفتر",
          "links": [
            {
              "label": "Website",
              "url": "https://example.com"
            }
          ],
          "invitedBy": {
            "handle": "reza",
            "displayName": "رضا احمدی"
          },
          "joinedAt": "2026-10-20T10:00:00.000Z"
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "url": {
            "type": "string",
            "maxLength": 300,
            "format": "uri"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "example": {
          "label": "Website",
          "url": "https://example.com"
        }
      },
      "MemberRef": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "handle",
          "displayName"
        ],
        "example": {
          "handle": "sara",
          "displayName": "سارا رحیمی"
        }
      },
      "SignInRequest": {
        "type": "object",
        "properties": {
          "telegram": {
            "$ref": "#/components/schemas/TelegramLogin"
          },
          "inviteCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "telegram"
        ]
      },
      "TelegramLogin": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "first_name": {
            "type": "string",
            "minLength": 1
          },
          "last_name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "auth_date": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "first_name",
          "auth_date",
          "hash"
        ],
        "additionalProperties": {
          "type": "string"
        },
        "example": {
          "id": "123456789",
          "first_name": "سارا",
          "last_name": "رحیمی",
          "username": "sara_dev",
          "photo_url": "https://t.me/i/userpic/320/sara_dev.jpg",
          "auth_date": "1792490400",
          "hash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        }
      },
      "UpdateMeRequest": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,29}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "bio": {
            "type": "string",
            "maxLength": 500
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "maxItems": 5
          }
        }
      },
      "MemberProfile": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Member"
          },
          {
            "type": "object",
            "properties": {
              "projects": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            },
            "required": [
              "projects"
            ]
          }
        ],
        "example": {
          "handle": "sara",
          "displayName": "سارا رحیمی",
          "bio": "برنامه‌نویس و سازندهٔ دفتر",
          "links": [
            {
              "label": "Website",
              "url": "https://example.com"
            }
          ],
          "invitedBy": {
            "handle": "reza",
            "displayName": "رضا احمدی"
          },
          "joinedAt": "2026-10-20T10:00:00.000Z",
          "projects": [
            {
              "slug": "daftar",
              "name": "دفتر",
              "oneLiner": "دفترچهٔ کار برای تیم‌های کوچک",
              "stage": "building",
              "visibility": "members",
              "links": [
                {
                  "label": "Website",
                  "url": "https://example.com"
                }
              ],
              "owners": [
                {
                  "handle": "sara",
                  "displayName": "سارا رحیمی"
                }
              ],
              "createdAt": "2026-10-20T10:00:00.000Z",
              "updatedAt": "2026-10-20T10:00:00.000Z"
            }
          ]
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "oneLiner": {
            "type": "string"
          },
          "stage": {
            "$ref": "#/components/schemas/ProjectStage"
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "maxItems": 5
          },
          "owners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberRef"
            },
            "minItems": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "slug",
          "name",
          "oneLiner",
          "stage",
          "visibility",
          "links",
          "owners",
          "createdAt",
          "updatedAt"
        ],
        "example": {
          "slug": "daftar",
          "name": "دفتر",
          "oneLiner": "دفترچهٔ کار برای تیم‌های کوچک",
          "stage": "building",
          "visibility": "members",
          "links": [
            {
              "label": "Website",
              "url": "https://example.com"
            }
          ],
          "owners": [
            {
              "handle": "sara",
              "displayName": "سارا رحیمی"
            }
          ],
          "createdAt": "2026-10-20T10:00:00.000Z",
          "updatedAt": "2026-10-20T10:00:00.000Z"
        }
      },
      "ProjectStage": {
        "type": "string",
        "enum": [
          "idea",
          "building",
          "launched"
        ]
      },
      "Visibility": {
        "type": "string",
        "enum": [
          "members",
          "public"
        ]
      },
      "ProjectPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "example": {
          "items": [
            {
              "slug": "daftar",
              "name": "دفتر",
              "oneLiner": "دفترچهٔ کار برای تیم‌های کوچک",
              "stage": "building",
              "visibility": "members",
              "links": [
                {
                  "label": "Website",
                  "url": "https://example.com"
                }
              ],
              "owners": [
                {
                  "handle": "sara",
                  "displayName": "سارا رحیمی"
                }
              ],
              "createdAt": "2026-10-20T10:00:00.000Z",
              "updatedAt": "2026-10-20T10:00:00.000Z"
            }
          ],
          "nextCursor": null
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "oneLiner": {
            "type": "string",
            "maxLength": 140,
            "default": ""
          },
          "stage": {
            "$ref": "#/components/schemas/ProjectStage"
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "maxItems": 5,
            "default": []
          }
        },
        "required": [
          "slug",
          "name"
        ]
      },
      "UpdateProjectRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "oneLiner": {
            "type": "string",
            "maxLength": 140
          },
          "stage": {
            "$ref": "#/components/schemas/ProjectStage"
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "maxItems": 5
          }
        }
      },
      "AddOwnerRequest": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,29}$"
          }
        },
        "required": [
          "handle"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The platform is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "The platform failed to answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/telegram": {
      "post": {
        "tags": [
          "auth"
        ],
        "security": [
          {
            "storefrontKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; a newcomer is created when the invite is valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            }
          },
          "400": {
            "description": "400: validation_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "401: storefront_key_invalid, telegram_signature_invalid, telegram_auth_expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "403: invite_required, invite_invalid, invite_expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "429: rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "security": [
          {
            "storefrontKey": [],
            "memberSession": []
          }
        ],
        "responses": {
          "204": {
            "description": "The current session was revoked"
          },
          "401": {
            "description": "401: storefront_key_invalid, session_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "members"
        ],
        "security": [
          {
            "storefrontKey": [],
            "memberSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "The signed-in member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "401": {
            "description": "401: storefront_key_invalid, session_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "members"
        ],
        "security": [
          {
            "storefrontKey": [],
            "memberSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "400": {
            "description": "400: validation_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "401: storefront_key_invalid, session_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "409: handle_taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/members/{handle}": {
      "get": {
        "tags": [
          "members"
        ],
        "security": [
          {
            "storefrontKey": [],
            "memberSession": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,29}$",
              "example": "sara"
            },
            "required": true,
            "name": "handle",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "A member's profile with the projects they own",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberProfile"
                }
              }
            }
          },
          "401": {
            "description": "401: storefront_key_invalid, session_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "404: not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "security": [
          {
            "storefrontKey": [],
            "memberSession": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of projects, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPage"
                }
              }
            }
          },
          "400": {
            "description": "400: validation_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "401: storefront_key_invalid, session_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "projects"
        ],
        "security": [
          {
            "storefrontKey": [],
            "memberSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The project was created; the caller is its first owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "400: validation_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "401: storefront_key_invalid, session_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "409: slug_taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{slug}": {
      "get": {
        "tags": [
          "projects"
        ],
        "security": [
          {
            "storefrontKey": [],
            "memberSession": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "example": "daftar"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "401": {
            "description": "401: storefront_key_invalid, session_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "404: not_found",
            "content": {
