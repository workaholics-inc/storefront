# All of these are server-only. Never give any of them a NEXT_PUBLIC_ prefix.
PLATFORM_URL=http://127.0.0.1:8787
STOREFRONT_API_KEY=
# The site's own origin, used to build the Telegram sign-in return address.
SITE_URL=
# The numeric client id of the site's Telegram login registration.
TELEGRAM_CLIENT_ID=
# Optional: override Telegram's authorization endpoint (mock mode sets it).
# TELEGRAM_AUTHORIZE_URL=
